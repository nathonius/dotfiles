#!/usr/bin/env bash

# Require bash 4.0+ for associative arrays
if [ "${BASH_VERSION%%.*}" -lt 4 ]; then
    echo "Error: This script requires bash 4.0 or newer (current: $BASH_VERSION)"
    echo "On macOS, install newer bash with: brew install bash"
    exit 1
fi

set -e

EMAIL="nathan@nathan-smith.org"
PLATFORM="linux"
DOMAIN="personal"
UBUNTU=false
WSL=false

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Source library files
source "${BASEDIR}/lib/utils.sh"
source "${BASEDIR}/lib/ui.sh"
source "${BASEDIR}/lib/dotfiles.sh"
source "${BASEDIR}/lib/tools.sh"

# Main execution function

# Main execution
main() {
    log_header "New Dotfiles Installer"
    log_info "This script replaces dotbot with an interactive installation process"
    
    detect_system
    check_prerequisites
    main_menu
    install_development_tools
    show_recommendations
    
    log_success "Installation completed!"
    log_info "You may need to restart your shell or run 'source ~/.zshrc' to see changes"
}

# Run main function
main "$@"